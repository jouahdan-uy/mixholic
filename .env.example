# YouTube Data API v3 key.
# Create a restricted browser key in Google Cloud and enable YouTube Data API v3.
VITE_YOUTUBE_API_KEY=

# Base URL of the Mixholic backend (server/index.ts). Defaults to
# http://localhost:3000 if left blank.
VITE_API_URL=

# Base URL of the real-time DM server (server/socket.ts). Defaults to
# http://localhost:3001 if left blank.
VITE_SOCKET_URL=
